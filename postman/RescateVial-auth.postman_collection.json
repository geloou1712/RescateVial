    {
      "name": "Login de ciudadano",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{citizenEmail}}\",\"password\":\"{{citizenPassword}}\",\"role\":\"ciudadano\"}",

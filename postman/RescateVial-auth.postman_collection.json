    {
      "name": "Registro de ciudadano",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Ciudadano de prueba\",\"email\":\"{{citizenEmail}}\",\"password\":\"{{citizenPassword}}\",\"role\":\"ciudadano\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registro inicial o cuenta de prueba previa\", () => pm.expect([201, 409]).to.include(pm.response.code));",
              "pm.test(\"Contrato del registro\", () => { const result = pm.response.json(); if (pm.response.code === 201) { pm.expect(result.role).to.eql(\"ciudadano\"); pm.expect(result.roles).to.eql([\"ciudadano\"]); pm.expect(result.id).to.be.a(\"number\"); } else { pm.expect(result.message).to.be.a(\"string\"); } });",
              "pm.test(\"La respuesta no expone contraseñas\", () => pm.expect(pm.response.text()).not.to.match(/contrasenaHash|contrasena_hash|password/));"
            ]
          }
        }
      ]
    },

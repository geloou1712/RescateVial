        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Token y contrato del login\", () => { const result = pm.response.json(); pm.expect(result.token).to.be.a(\"string\").and.not.empty; pm.expect(result.user.role).to.eql(\"ciudadano\"); pm.environment.set(\"citizenToken\", result.token); });",
              "pm.test(\"La respuesta no expone contraseñas\", () => pm.expect(pm.response.text()).not.to.match(/contrasenaHash|contrasena_hash|password/));"
            ]
          }
        }

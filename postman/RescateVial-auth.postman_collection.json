          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Neon disponible\", () => pm.expect(pm.response.json().estado).to.eql(\"UP\"));"

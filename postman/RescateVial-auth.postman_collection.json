{
  "info": {
    "name": "RescateVial - Autenticación local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas reales de autenticación, validación, CORS y roles. Usar un entorno privado con las credenciales de prueba de .env. La colección admite cuentas de prueba existentes y comprueba sus credenciales mediante login."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Salud pública",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Conexión real con Neon",
      "request": {
        "method": "GET",
